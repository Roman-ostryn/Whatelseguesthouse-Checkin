# Copy to .env on the hotel PC. Do not commit .env.
# Do not paste real passwords in chat or into this example file.

# SIBA / AIMA — Web Services (Boletim de Alojamento)
# From the SIBA portal letter / login screen.
SIBA_NIF=
SIBA_ESTABELECIMENTO=
SIBA_CHAVE=
SIBA_ENDPOINT=https://siba.ssi.gov.pt/baws/boletinsalojamento.asmx
# Development / test endpoint (use only while testing):
# SIBA_ENDPOINT=https://siba.ssi.gov.pt/bawsdev/boletinsalojamento.asmx

# Hotel unit block required in each SIBA XML
SIBA_HOTEL_NAME=Whatelse Guest House
SIBA_HOTEL_ABBREV=Whatelse
SIBA_MORADA=
SIBA_LOCALIDADE=Fatima
SIBA_CODIGO_POSTAL=
SIBA_ZONA_POSTAL=
SIBA_TELEFONE=
SIBA_FAX=000000000
SIBA_NOME_CONTACTO=Joao
SIBA_EMAIL_CONTACTO=

# INE — WebInq (monthly IPHH). Login reminder only; Quadro 1 is built in /ine.
INE_WEBINQ_USER=
INE_WEBINQ_PASSWORD=
INE_WEBINQ_URL=https://webinq.ine.pt

# Guest check-in links (15 days before arrival — Joao)
# Public URL guests open (ngrok / Railway / VPS https → this app). Required for email links.
CHECKIN_PUBLIC_BASE_URL=
CHECKIN_LINK_DAYS_BEFORE=15

# Email guest links via Resend (same idea as invoice details letters)
# RESEND_API_KEY=
# RESEND_FROM=Whatelse Guest House <checkin@your-domain.pt>

# Optional later: eviivo auto-create links 15 days before
# EVIIVO_CLIENT_ID=
# EVIIVO_CLIENT_SECRET=

